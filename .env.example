# 任务查询/调度要求 meta-agent runtime >= 0.11.1。
# 可设为本地构建的 dist/cli-glm.mjs 的绝对路径。
META_AGENT_TASKS_BIN=meta-agent-glm
# 默认只显示 GLM 配置所属任务；设 all 可查看所有配置。
# META_AGENT_TASKS_PROFILE=/absolute/path/to/glm_config.json
# 可选：runtime 包根目录（默认由 CLI 路径自动定位）。
# META_AGENT_TASKS_RUNTIME_DIR=/absolute/path/to/meta_agent_runtime
META_AGENT_TASKS_MAX_RUNNING=3
META_AGENT_TASKS_POLL_MS=5000

# 保留现有微信白名单配置方式。
# WEIXIN_ALLOW_FROM=allowed-from-user-id

# 新版 iLink 原生工具进度（输入和输出不会作为进度消息发送）。
WEIXIN_REPLY_PROGRESS_MESSAGES=true
# 公共客户端身份，可填 ASCII Product/version 格式。
WEIXIN_BOT_AGENT=IMMetaAgent/1.0.0
# 本地引用缓存默认开启；设 false 可关闭。
WEIXIN_QUOTE_CACHE_ENABLED=true
# 多账号时可固定运行的账号；默认使用最近登录账号。
# WEIXIN_ACCOUNT_ID=your-ilink-bot-id
