# 1.5：直接发消息，常驻助理处理；大任务确认文件夹后启动 auto 工作任务。快捷命令见 README。
# ---- meta-agent（1.5.3 起所有用途统一：auto 工作任务、聊天助理、tasks 运维、人工工单）----
# 选择 CLI：meta-agent（默认，模型配置 ~/.meta-agent/config.json）或 meta-agent-glm（~/.meta-agent/glm_config.json）。
# META_AGENT_CLI=meta-agent
# runtime 根目录：设置后使用该目录的 dist/cli.mjs 或 dist/cli-glm.mjs（随 META_AGENT_CLI），不依赖 PATH。
# META_AGENT_RUNTIME_DIR=/absolute/path/to/meta_agent_runtime
# 可选：显式指定可执行文件（只改变位置，请指向与 META_AGENT_CLI 一致的那个 CLI）。
# META_AGENT_BIN=/absolute/path/to/meta-agent
# 可选：显式指定模型配置文件，覆盖 META_AGENT_CLI 的默认配置。
# META_AGENT_CONFIG_FILE=/absolute/path/to/config.json
# 已停用（设置了会被忽略，启动日志与 npm run agent:check 会提示）：
#   META_AGENT_TASKS_BIN、META_AGENT_HUMAN_BIN、META_AGENT_TALK_PROFILE、META_AGENT_TASKS_PROFILE；
#   META_AGENT_TASKS_RUNTIME_DIR 仍可用但请改名为 META_AGENT_RUNTIME_DIR。
META_AGENT_MAX_CONCURRENT=2
# 1.5.2：工作任务默认请求精简事件流（meta-agent ≥ 0.14.2 生效，旧版忽略）；需要完整事件流时取消注释。
# META_AGENT_JSON_EVENTS=full

# ---- 轮数与预算 ----
# 不设置时使用 meta-agent 自身默认值（auto / simple_auto：每次运行最多 1000 轮，会话累计预算 $300）。
# 设置后作为 --max-turns / --max-budget-usd 传给对应模式。
# 注意：META_AGENT_AUTO_MAX_BUDGET_USD 同时是 runtime 自己读取的环境变量，对 auto 和 simple_auto（即 /talk）都生效；
# /talk 想单独设置时再设 META_AGENT_TALK_MAX_BUDGET_USD。
# 1.3 及以前的 META_AGENT_MAX_TURNS / META_AGENT_MAX_BUDGET_USD 已停用（会被忽略并在日志提示）。
# META_AGENT_AUTO_MAX_TURNS=1000
# META_AGENT_AUTO_MAX_BUDGET_USD=300
# META_AGENT_TALK_MAX_TURNS=200
# META_AGENT_TALK_MAX_BUDGET_USD=5
# /auto 单轮执行超时（毫秒，0 = 不限，由 runtime 自身时限控制）。
META_AGENT_TIMEOUT_MS=0
# /talk 单条消息超时（毫秒，默认 15 分钟，0 = 不限）。聊天按会话串行，超时避免一条消息长期占住聊天。
# META_AGENT_TALK_TIMEOUT_MS=900000

# 1.5 常驻助理（需要 meta-agent ≥ 0.14，提供 `meta-agent serve`；更早的版本自动退回单次运行）。
# 设为 false 强制每条消息单次运行。
# IM_TALK_SERVE=true
# 助理可以浏览、可以在里面开展工作任务的文件夹（逗号分隔，绝对路径或 ~/ 开头；不能是 / 或整个家目录）。
# 未设置时工作任务只使用机器人管理的独立目录。auto 会直接修改这些文件夹里的文件。
# IM_WORKSPACE_ROOTS=~/code,~/work
# 助理按意图查找文件夹时扫描的层数（1-4，默认 2；进入项目后不再深入）。
# IM_WORKSPACE_SCAN_DEPTH=2
# 单次运行（退回模式）时同时进行的聊天数；聊天不占 META_AGENT_MAX_CONCURRENT 的工作额度。
# META_AGENT_TALK_MAX_CONCURRENT=2
# 一条消息处理超过这么久先回“正在处理”（毫秒，0 关闭）；处理中会显示“正在输入”（IM_TYPING=false 关闭）。
# IM_SLOW_NOTICE_MS=20000
# IM_TYPING=true
# META_AGENT_MODE 和 WEIXIN_TRIGGER_PREFIX 不再选择消息类型；1.5 起没有模式，所有消息交给助理。
WEIXIN_GROUP_TRIGGER=off

# 任务运维控制台（tasks --agentic）要求构建包含 @meta-agent/runtime/im 契约 v1 的 runtime（本地 0.13.0 源码已支持）。
# CLI 与模型配置见文件开头的 META_AGENT_CLI（模型配置同时决定运维会话 scope）。
# 可选：限定控制台可见的工作区（逗号分隔绝对路径），默认全部。
# META_AGENT_TASKS_WORKSPACES=/abs/path/a,/abs/path/b
# 托管执行器并发上限（1-64）。
META_AGENT_TASKS_MAX_RUNNING=3
# 单轮运维对话的模型轮数 / 会话累计费用上限（24 小时内）。
# META_AGENT_TASKS_MAX_TURNS=30
# META_AGENT_TASKS_MAX_BUDGET_USD=10
# 单条消息超时（毫秒，默认 300000；0 = 不限）。超时中断并保存进度。
# META_AGENT_TASKS_TURN_TIMEOUT_MS=300000
# 运维会话存储根目录（默认微信状态目录 personal-agent/task-ops，按账号/会话分层，与终端 console 隔离；
# 运维会话固定 24 小时有效，过期自动清空历史并新建）。
# META_AGENT_TASKS_OPS_ROOT=/absolute/path
# 是否允许微信侧执行 Studio 生命周期操作（默认 false，仅终端确认）。
# META_AGENT_TASKS_ALLOW_STUDIO_CONTROL=false

# 访问控制：未设置时只允许“主人”使用——首位私聊者自动绑定为主人，其他人的消息被静默拒绝并告警。
# 设置后只允许列出的用户（逗号分隔）；设为 * 表示不限制（不建议）。
# 查看/调整绑定：npm run agent -- --owner | --bind-owner <用户ID> | --reset-owner（后两者需先停止服务）。
# WEIXIN_ALLOW_FROM=allowed-from-user-id

# 执行进度保存在 personal-agent/executions；发送 /tasks inspect A1 查看。
# 公共客户端身份，可填 ASCII Product/version 格式。
WEIXIN_BOT_AGENT=IMMetaAgent/1.5.0
# 本地引用缓存默认开启；设 false 可关闭。
WEIXIN_QUOTE_CACHE_ENABLED=true
# 多账号时可固定运行的账号；默认使用最近登录账号。
# WEIXIN_ACCOUNT_ID=your-ilink-bot-id

# sapiens 人工工单（外部 runtime 建议 >= 0.12.1；与 runtime 使用相同系统用户和 META_AGENT_HOME）。
# 默认不开启；开启后首次私聊自动识别并记住唯一收件人，无需填写 userId。
META_AGENT_HUMAN_ENABLED=false
# 使用与其他用途相同的 CLI（META_AGENT_CLI）。
# 工单事件轮询间隔，毫秒（最小 1000）。
META_AGENT_HUMAN_POLL_MS=5000

# ---- 日志 ----
# 常驻进程的应用日志写入按大小轮转的文件（deploy/start.sh 默认 logs/im-metaagent.log；设为 stderr 恢复旧行为）。
# IM_LOG_FILE=logs/im-metaagent.log
# IM_LOG_MAX_MB=10
# IM_LOG_FILES=5
# 相同 warn/error 在窗口内只写一次，窗口结束时汇报重复次数（毫秒）。
# IM_LOG_REPEAT_WINDOW_MS=300000

# ---- 告警（微信掉线、长时间断网、陌生人消息、无法送达的提醒）----
# 默认复用 meta-agent 配置文件（META_AGENT_CONFIG_FILE 或 ~/.meta-agent/config.json）里的 notify.channels，
# 使用 notify.default 通道；可用 IM_ALERT_CHANNEL 指定通道名，设为 none 关闭。
# IM_ALERT_CHANNEL=me
# 或直接指定 webhook（类型按域名识别：飞书 / Lark / Slack，其他按通用 webhook 发送 {"text": ...}）。
# IM_ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# IM_ALERT_WEBHOOK_SECRET=
# macOS 本机通知（服务运行在本机登录会话中时有效）。
# IM_ALERT_DESKTOP=true
# 轮询连续失败多少分钟后告警。
# IM_ALERT_OFFLINE_MINUTES=10
# 测试：npm run agent -- --alert-test

# ---- 聊天 ----
# /talk 是 meta-agent CLI 的 simple_auto 会话：工具、搜索服务和 MCP 服务（~/.meta-agent/mcp.json）都由 runtime 提供，
# IM 不再在进程内创建 runtime。搜索服务按 Tavily → GLM（mcp.json 中的 web-search-prime）→ Anthropic 顺序取第一个可用。

# ---- 任务交付文件 ----
# Auto 任务登记的交付文件（task_journal artifact）随结果发回微信；未登记时发送本轮新生成的文档/图片类文件。
# IM_SEND_FILES=true
# IM_SEND_FILES_MAX=5
# IM_SEND_FILE_MAX_MB=25

# ---- 任务状态与待决策 ----
# 有任务在进行（运行中、排队、暂停、待决策）时，每隔这么久批量核对一次 runtime 状态并推送待决策（毫秒，0 关闭待决策推送）。
# 只核对还可能变化的任务（含最近 3 天结束的）；都已结束时改为每 10 分钟一次，没有这类任务时不核对。
# 核对在机器人进程内一次查询完成，不再每个任务启动一个 meta-agent 进程；状态变化时才写盘。
# META_AGENT_DECISION_POLL_MS=120000

# ---- 数据保留 ----
# 已完成的收件/发件/执行记录、执行目录、附件副本、已关闭的聊天/运维上下文，
# 以及聊天工作区里的 im-inputs/ 附件副本、outbox/ 文件和定时执行的每次运行目录，保留天数（0 关闭清理）。
# 运行中、排队、未知状态和待发送的数据不会被清理；工作任务记录本身保留。
# 手动：npm run agent -- --prune --dry-run
# IM_RETENTION_DAYS=7
# 独立目录任务（机器人在 personal-agent/workspaces/ 下为任务新建的目录）的整个工作区，
# 在任务结束且超过保留期后是否一并删除。里面通常有交付文件，默认不删；设为 true 后被清理的任务不能再继续。
# 你自己的文件夹（IM_WORKSPACE_ROOTS 内）和项目目录永远不会被删除。
# IM_PRUNE_TASK_WORKSPACES=false
