# 四种会话模式：单独发送 /tasks、/human、/talk、/auto 进入；直接发内容；对应 xxx/ 退出。
# 指向含公开 IM 接口的 runtime 根目录，会自动选择该目录 dist/cli*.mjs。
# META_AGENT_RUNTIME_DIR=/absolute/path/to/meta_agent_runtime
# 工作任务可单独指定 CLI；默认 meta-agent 或上面的 runtime 目录。
# META_AGENT_BIN=/absolute/path/to/meta-agent
# /talk 默认使用 META_AGENT_CONFIG_FILE 或 ~/.meta-agent/config.json。
# META_AGENT_TALK_PROFILE=/absolute/path/to/chat_config.json
META_AGENT_MAX_CONCURRENT=2
META_AGENT_MAX_TURNS=30
META_AGENT_MAX_BUDGET_USD=10
META_AGENT_TIMEOUT_MS=0
# META_AGENT_MODE 和 WEIXIN_TRIGGER_PREFIX 不再选择消息类型；使用独立消息进入/退出模式。
WEIXIN_GROUP_TRIGGER=off

# 任务运维控制台（tasks --agentic）要求构建包含 @meta-agent/runtime/im 契约 v1 的 runtime（本地 0.13.0 源码已支持）。
# 可设为本地构建的 dist/cli-glm.mjs 的绝对路径。
# META_AGENT_TASKS_BIN=meta-agent-glm
# 运维会话的模型配置（默认 ~/.meta-agent/glm_config.json，同时决定会话 scope）。
# META_AGENT_TASKS_PROFILE=/absolute/path/to/glm_config.json
# 可选：限定控制台可见的工作区（逗号分隔绝对路径），默认全部。
# META_AGENT_TASKS_WORKSPACES=/abs/path/a,/abs/path/b
# 托管执行器并发上限（1-64）。
META_AGENT_TASKS_MAX_RUNNING=3
# 单轮运维对话的模型轮数 / 会话累计费用上限（24 小时内）。
# META_AGENT_TASKS_MAX_TURNS=30
# META_AGENT_TASKS_MAX_BUDGET_USD=10
# 单条消息超时（毫秒，默认 300000；0 = 不限）。超时中断并保存进度。
# META_AGENT_TASKS_TURN_TIMEOUT_MS=300000
# 运维会话存储根目录（默认微信状态目录 personal-agent/task-ops，按账号/会话分层，与终端 console 隔离；
# 运维会话固定 24 小时有效，过期自动清空历史并新建）。
# META_AGENT_TASKS_OPS_ROOT=/absolute/path
# 是否允许微信侧执行 Studio 生命周期操作（默认 false，仅终端确认）。
# META_AGENT_TASKS_ALLOW_STUDIO_CONTROL=false
# 可选：runtime 包根目录（默认由 CLI 路径自动定位）。
# META_AGENT_TASKS_RUNTIME_DIR=/absolute/path/to/meta_agent_runtime

# 访问控制：未设置时只允许“主人”使用——首位私聊者自动绑定为主人，其他人的消息被静默拒绝并告警。
# 设置后只允许列出的用户（逗号分隔）；设为 * 表示不限制（不建议）。
# 查看/调整绑定：npm run agent -- --owner | --bind-owner <用户ID> | --reset-owner（后两者需先停止服务）。
# WEIXIN_ALLOW_FROM=allowed-from-user-id

# 执行进度保存在 personal-agent/executions；进入 /tasks 模式后发送 inspect A1 查看。
# 公共客户端身份，可填 ASCII Product/version 格式。
WEIXIN_BOT_AGENT=IMMetaAgent/1.3.0
# 本地引用缓存默认开启；设 false 可关闭。
WEIXIN_QUOTE_CACHE_ENABLED=true
# 多账号时可固定运行的账号；默认使用最近登录账号。
# WEIXIN_ACCOUNT_ID=your-ilink-bot-id

# sapiens 人工工单（外部 runtime 建议 >= 0.12.1；与 runtime 使用相同系统用户和 META_AGENT_HOME）。
# 默认不开启；开启后首次私聊自动识别并记住唯一收件人，无需填写 userId。
META_AGENT_HUMAN_ENABLED=false
# 默认沿用 META_AGENT_TASKS_BIN，否则 meta-agent-glm。
# META_AGENT_HUMAN_BIN=/absolute/path/to/meta-agent-glm
# 工单事件轮询间隔，毫秒（最小 1000）。
META_AGENT_HUMAN_POLL_MS=5000

# ---- 日志 ----
# 常驻进程的应用日志写入按大小轮转的文件（deploy/start.sh 默认 logs/im-metaagent.log；设为 stderr 恢复旧行为）。
# IM_LOG_FILE=logs/im-metaagent.log
# IM_LOG_MAX_MB=10
# IM_LOG_FILES=5
# 相同 warn/error 在窗口内只写一次，窗口结束时汇报重复次数（毫秒）。
# IM_LOG_REPEAT_WINDOW_MS=300000

# ---- 告警（微信掉线、长时间断网、陌生人消息、无法送达的提醒）----
# 默认复用 meta-agent 配置文件（META_AGENT_CONFIG_FILE 或 ~/.meta-agent/config.json）里的 notify.channels，
# 使用 notify.default 通道；可用 IM_ALERT_CHANNEL 指定通道名，设为 none 关闭。
# IM_ALERT_CHANNEL=me
# 或直接指定 webhook（类型按域名识别：飞书 / Lark / Slack，其他按通用 webhook 发送 {"text": ...}）。
# IM_ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# IM_ALERT_WEBHOOK_SECRET=
# macOS 本机通知（服务运行在本机登录会话中时有效）。
# IM_ALERT_DESKTOP=true
# 轮询连续失败多少分钟后告警。
# IM_ALERT_OFFLINE_MINUTES=10
# 测试：npm run agent -- --alert-test

# ---- 聊天工具 ----
# /talk 默认可联网搜索/读取网页（web_search 需在 runtime 配置搜索服务，如 Tavily 或 GLM）。设 false 关闭。
# META_AGENT_TALK_WEB=true

# ---- 任务交付文件 ----
# Auto 任务登记的交付文件（task_journal artifact）随结果发回微信；未登记时发送本轮新生成的文档/图片类文件。
# IM_SEND_FILES=true
# IM_SEND_FILES_MAX=5
# IM_SEND_FILE_MAX_MB=25

# ---- 待决策 ----
# 轮询 runtime 中 needs-decision 的微信任务并推送（毫秒，0 关闭）。
# META_AGENT_DECISION_POLL_MS=120000

# ---- 数据保留 ----
# 已完成的收件/发件/执行记录、执行目录、附件副本和已关闭的聊天/运维上下文保留天数（0 关闭清理）。
# 运行中、排队、未知状态和待发送的数据不会被清理；工作任务记录本身保留。
# 手动：npm run agent -- --prune --dry-run
# IM_RETENTION_DAYS=30
