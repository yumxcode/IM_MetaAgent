[Unit]
Description=IM MetaAgent (WeChat <-> meta-agent bridge)
Documentation=https://github.com/yumxcode/IM_MetaAgent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
Environment=__ENV_HOME__
Environment=__ENV_PATH__
ExecStart=/bin/bash __START__

# 崩溃自动重启（非0退出/信号），正常退出(exit 0)不重启
Restart=on-failure
RestartSec=15
# stdout/stderr 写文件；journalctl 主要显示服务启停信息。
StandardOutput=append:__LOG_OUT__
StandardError=append:__LOG_ERR__

# 优雅关闭：SIGTERM 给 node 主进程，10s 后仍未退出则 SIGKILL
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
