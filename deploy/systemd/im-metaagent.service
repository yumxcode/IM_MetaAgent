[Unit]
Description=IM MetaAgent (WeChat <-> meta-agent bridge)
Documentation=https://github.com/yumxcode/IM_MetaAgent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
Environment=__ENV_HOME__
Environment=__ENV_PATH__
ExecStart=/bin/bash __START__

# 崩溃自动重启（非0退出/信号），正常退出(exit 0)不重启
Restart=on-failure
RestartSec=15
# stdout/stderr 写文件；journalctl 主要显示服务启停信息。
StandardOutput=append:__LOG_OUT__
StandardError=append:__LOG_ERR__

# 只停止消息接入进程；已提交的独立执行进程保留，重启后重新读取回执。
# 取消具体执行请用 进入 /tasks 模式后发送 cancel A1。
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
